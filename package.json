{
  "name": "fitcoach",
  "private": true,
  "description": "FitCoach — Personal Trainer Copilot (MVP closed beta)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "turbo run lint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:db": "node scripts/not-yet.mjs test:db 1.2",
    "test:api": "node scripts/not-yet.mjs test:api 1.2",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/not-yet.mjs db:migrate 1.2",
    "db:generate": "node scripts/not-yet.mjs db:generate 1.2",
    "db:seed": "node scripts/not-yet.mjs db:seed 1.3",
    "db:reset": "node scripts/not-yet.mjs db:reset 1.2",
    "api:client": "node scripts/not-yet.mjs api:client 1.2",
    "platform:grant": "node scripts/not-yet.mjs platform:grant 1.3",
    "beta:invite": "node scripts/not-yet.mjs beta:invite 1.3",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm test:api && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fitcoach/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3"
  }
}
