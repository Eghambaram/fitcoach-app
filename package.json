{
  "name": "fitcoach",
  "private": true,
  "description": "FitCoach — Personal Trainer Copilot (MVP closed beta)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "turbo run lint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "test:api": "turbo run test:api",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @fitcoach/api db:migrate",
    "db:generate": "pnpm --filter @fitcoach/api db:generate",
    "db:seed": "pnpm --filter @fitcoach/api db:seed",
    "db:reset": "pnpm --filter @fitcoach/api db:reset",
    "api:client": "pnpm --filter @fitcoach/api openapi && pnpm --filter @fitcoach/api-client generate",
    "platform:grant": "pnpm --filter @fitcoach/api platform:grant",
    "beta:invite": "pnpm --filter @fitcoach/api beta:invite",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm test:api && pnpm build && pnpm test:e2e",
    "storage:init": "pnpm --filter @fitcoach/api storage:init"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fitcoach/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3"
  }
}
