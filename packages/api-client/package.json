{
  "name": "@fitcoach/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed FitCoach API client: types generated from the API's OpenAPI document (`pnpm api:client`) + a thin openapi-fetch wrapper.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.json -o src/schema.ts && prettier --write src/schema.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@fitcoach/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
