  "info": {
    "title": "FitCoach API",
    "description": "Reached by the browser only through the web app's same-origin /api proxy.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SignupRequestDto": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "maxLength": 254,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "password": {
                "type": "string",
                "minLength": 10,
                "maxLength": 128
              }
            },
            "required": [
              "email",
              "password"
            ]
          },
          "profile": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "phone": {
                "type": "string",
                "maxLength": 32
              }
            },
            "required": [
              "displayName"
            ]
          },
          "business": {
            "type": "object",
            "properties": {
              "businessName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "slug": {
                "type": "string",
                "minLength": 3,
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "city": {
                "type": "string",
                "maxLength": 80
              },
              "coachingModes": {
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "in_person",
                    "online",
                    "hybrid"
                  ]
                }
              },
              "timezone": {
                "default": "Asia/Kolkata",
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "businessName",
              "slug",
              "coachingModes"
            ]
          },
          "inviteCode": {
            "type": "string",
            "maxLength": 32
          },
          "acceptTerms": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "account",
          "profile",
          "business",
          "acceptTerms"
        ]
      },
      "AcceptedResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "TokenRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "token"
        ]
      },
      "OkResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "EmailOnlyRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "emailVerified"
            ]
          },
          "actor": {
            "type": "string",
            "enum": [
              "trainer",
              "client",
              "platform_owner"
            ]
          },
          "profile": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string"
              }
            },
            "required": [
              "displayName"
            ]
          },
          "workspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending_approval",
                  "trialing",
                  "active",
                  "past_due",
                  "suspended",
                  "cancelled"
                ]
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "slug",
              "status",
              "timezone"
            ],
            "nullable": true
          }
        },
        "required": [
          "user",
          "actor",
          "profile",
          "workspace"
        ]
      },
      "SessionsResponseDto": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "createdAt": {
                  "type": "string"
                },
                "lastSeenAt": {
                  "type": "string"
                },
                "expiresAt": {
                  "type": "string"
                },
                "userAgent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "current": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "createdAt",
                "lastSeenAt",
                "expiresAt",
                "userAgent",
                "current"
              ]
            }
          }
        },
        "required": [
          "sessions"
        ]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "degraded",
                      "unknown",
                      "not_configured"
                    ]
                  },
                  "latencyMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "status"
                ]
              },
              "jobs": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "degraded",
                      "unknown",
                      "not_configured"
                    ]
                  },
                  "latencyMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "status"
                ]
              },
              "storage": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "degraded",
                      "unknown",
                      "not_configured"
                    ]
                  },
                  "latencyMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "database",
              "jobs",
              "storage"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      }
    }
  }
}
