{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/db-backup/Dockerfile",
    "watchPatterns": ["infra/db-backup/**", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
  },
  "deploy": {
    "cronSchedule": "30 20 * * *",
    "restartPolicyType": "NEVER"
  }
}
