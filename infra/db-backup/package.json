{
  "name": "@fitcoach/db-backup",
  "version": "0.0.0",
  "private": true,
  "description": "Nightly pg_dump of the FitCoach database to the private R2 bucket, with retention and a heartbeat to the API (PROMPT §17.2).",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0"
  },
  "devDependencies": {
    "@fitcoach/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
