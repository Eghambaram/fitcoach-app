# Railway → environment "staging" → service "web" → Variables → Raw Editor.
# Nothing to replace: every value is fixed or a Railway reference variable (${{...}}).
# The API service must be named "api". NEXT_PUBLIC_* are build-time — redeploy web after changing them.
# Guide: docs/deployment/railway.md (step 4).

RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile
NEXT_PUBLIC_SITE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_APP_ENV=staging
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
HOSTNAME=::
PORT=3000
