# Railway → environment "staging" → service "api" → Variables → Raw Editor.
# Paste this file, then replace every <PLACEHOLDER>. Never commit the filled-in values.
# ${{...}} are Railway reference variables — paste them exactly as written.
# Guide: docs/deployment/railway.md (step 3) and docs/deployment/r2.md.

# Build with the repo's Dockerfile (Railway may ignore apps/api/railway.json, ADR-0043).
RAILWAY_DOCKERFILE_PATH=apps/api/Dockerfile

APP_ENV=staging
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# Database — Postgres service must be named "Postgres". The container migrates on start with the
# owner URL (roles get DB_APP_PASSWORD / DB_SYSTEM_PASSWORD), then serves as fitcoach_app/fitcoach_system.
# Generate each password: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_OWNER_URL=${{Postgres.DATABASE_URL}}
DB_APP_PASSWORD=<GENERATED_HEX_1>
DB_SYSTEM_PASSWORD=<GENERATED_HEX_2>
DATABASE_URL=postgresql://fitcoach_app:${{DB_APP_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_SYSTEM_URL=postgresql://fitcoach_system:${{DB_SYSTEM_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_POOL_MAX=10

# Secrets — same generator as above, a different value for each.
SESSION_SECRET=<GENERATED_HEX_3>
IP_HASH_SALT=<GENERATED_HEX_4>

# Closed beta
SIGNUP_MODE=invite_code
BETA_DEFAULT_CLIENT_LIMIT=50

# Email — Resend API key with "Sending access". Without a verified domain, Resend only
# delivers from onboarding@resend.dev to your own Resend account email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=FitCoach Staging <onboarding@resend.dev>

# Cloudflare R2 — staging buckets and the token scoped to them (docs/deployment/r2.md).
STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
STORAGE_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
STORAGE_PRIVATE_BUCKET=fitcoach-staging-private
STORAGE_PUBLIC_BUCKET=fitcoach-staging-public
STORAGE_PUBLIC_BASE_URL=https://<PUB_ID>.r2.dev
STORAGE_KEY_PREFIX=
STORAGE_BUDGET_BYTES=8589934592
STORAGE_HARD_LIMIT_BYTES=9663676416
