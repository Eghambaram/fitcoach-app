# Railway → environment "production" → service "db-backup" → Variables → Raw Editor.
# Replace every <PLACEHOLDER>. Never commit the filled-in values.
# Guide: docs/deployment/railway.md (step 9) and docs/runbooks/restore.md.

RAILWAY_DOCKERFILE_PATH=infra/db-backup/Dockerfile

# Admin URL: pg_dump must read every table (past RLS). Private network only.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# The same R2 token and private bucket as the production API (the token is scoped to production's buckets).
STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
STORAGE_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
STORAGE_PRIVATE_BUCKET=fitcoach-prod-private
STORAGE_KEY_PREFIX=

# Heartbeat to the API over the private network; the token must equal the API's BACKUP_HEARTBEAT_TOKEN.
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
BACKUP_HEARTBEAT_TOKEN=${{api.BACKUP_HEARTBEAT_TOKEN}}
BACKUP_TIMEZONE=Asia/Kolkata
