# Railway → environment "production" → service "web" → Variables → Raw Editor.
# NEXT_PUBLIC_* are build-time — redeploy web after changing them. Guide: docs/deployment/production.md.

RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile
NEXT_PUBLIC_SITE_URL=https://app.<YOUR_DOMAIN>
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_BETA_CONTACT_EMAIL=getfitcoach.app@gmail.com
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
HOSTNAME=::
PORT=3000
# Optional: NEXT_PUBLIC_TURNSTILE_SITE_KEY=<TURNSTILE_SITE_KEY>
