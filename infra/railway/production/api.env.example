# Railway → environment "production" → service "api" → Variables → Raw Editor.
# Replace every <PLACEHOLDER> with NEW values (never reuse staging secrets). Never commit them.
# Guide: docs/deployment/production.md. The API refuses to start if a production rule is broken
# (https origin, no console email, R2 on its custom domain, heartbeat token set, not the local
# encryption key) and names the variable.

RAILWAY_DOCKERFILE_PATH=apps/api/Dockerfile

APP_ENV=production
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=https://app.<YOUR_DOMAIN>

# Database — generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_OWNER_URL=${{Postgres.DATABASE_URL}}
DB_APP_PASSWORD=<GENERATED_HEX_1>
DB_SYSTEM_PASSWORD=<GENERATED_HEX_2>
DATABASE_URL=postgresql://fitcoach_app:${{DB_APP_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_SYSTEM_URL=postgresql://fitcoach_system:${{DB_SYSTEM_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_POOL_MAX=10

# Secrets — hex for these three; base64 for the encryption key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<GENERATED_HEX_3>
IP_HASH_SALT=<GENERATED_HEX_4>
BACKUP_HEARTBEAT_TOKEN=<GENERATED_HEX_5>
# The db-backup service takes the nightly dump (ADR-0063); the API doesn't (ADR-0064).
NIGHTLY_BACKUP=external
APP_ENCRYPTION_KEY=<GENERATED_BASE64_32_BYTES>

# Closed beta
SIGNUP_MODE=invite_code
BETA_DEFAULT_CLIENT_LIMIT=50

# Email — Resend with your verified domain (console is refused in production).
EMAIL_PROVIDER=resend
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=FitCoach <noreply@<YOUR_DOMAIN>>

# Cloudflare R2 — production buckets, the production-only token, the media custom domain.
STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<PROD_R2_ACCESS_KEY_ID>
STORAGE_SECRET_ACCESS_KEY=<PROD_R2_SECRET_ACCESS_KEY>
STORAGE_PRIVATE_BUCKET=fitcoach-prod-private
STORAGE_PUBLIC_BUCKET=fitcoach-prod-public
STORAGE_PUBLIC_BASE_URL=https://media.<YOUR_DOMAIN>
STORAGE_KEY_PREFIX=
STORAGE_BUDGET_BYTES=8589934592
STORAGE_HARD_LIMIT_BYTES=9663676416

# Optional: Turnstile on the public enquiry form (with the web's NEXT_PUBLIC_TURNSTILE_SITE_KEY).
# TURNSTILE_SECRET_KEY=<TURNSTILE_SECRET_KEY>
