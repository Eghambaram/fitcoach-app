# FitCoach — local development values (names match PROMPT §17.3). Copy to `.env`.
# Values here are for the docker-compose services only; never put real secrets in this file.
# Variables are added as the steps that need them land. The API validates its config at boot (apps/api/src/config/env.ts).

# --- shared ---
APP_ENV=development
LOG_LEVEL=info

# --- api ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Salt for hashing IPs in logs and rate-limit keys (never log raw IPs). 32+ random chars outside local dev.
IP_HASH_SALT=local-dev-ip-hash-salt-not-secret

# Database (PROMPT §4.5). Request traffic uses fitcoach_app (no BYPASSRLS); SystemDb uses fitcoach_system.
# The owner URL is used only by `pnpm db:migrate` / Railway's preDeployCommand, which also creates the
# two roles with the passwords below — keep them in sync with the URLs.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/fitcoach
DATABASE_URL=postgres://fitcoach_app:fitcoach-app-local@localhost:5432/fitcoach
DATABASE_SYSTEM_URL=postgres://fitcoach_system:fitcoach-system-local@localhost:5432/fitcoach
DB_APP_PASSWORD=fitcoach-app-local
DB_SYSTEM_PASSWORD=fitcoach-system-local
DB_POOL_MAX=10

# Email (Mailpit locally — UI at http://localhost:8025)
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="FitCoach <noreply@fitcoach.local>"

# Storage (RustFS locally, S3-compatible like R2 — console at http://localhost:9001/rustfs/console/)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=localaccesskey
STORAGE_SECRET_ACCESS_KEY=localsecretkey
STORAGE_PRIVATE_BUCKET=fitcoach-local-private
STORAGE_PUBLIC_BUCKET=fitcoach-local-public
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/fitcoach-local-public

# --- web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
API_INTERNAL_URL=http://localhost:4000
