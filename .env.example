# FitCoach — local development values (names match PROMPT §17.3). Copy to `.env`.
# Values here are for the docker-compose services only; never put real secrets in this file.
# Variables are added as the steps that need them land. The API validates its config at boot (apps/api/src/config/env.ts).

# --- shared ---
APP_ENV=development
LOG_LEVEL=info

# --- api ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Salt for hashing IPs in logs and rate-limit keys (never log raw IPs). 32+ random chars outside local dev.
IP_HASH_SALT=local-dev-ip-hash-salt-not-secret

# Keys the HMAC of session cookies, email links and beta codes. 32+ random characters; rotate = sign everyone out.
SESSION_SECRET=local-dev-session-secret-not-secret-0123456789
# Encrypts platform owner TOTP secrets (AES-256-GCM): 32 random bytes, base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates every platform owner's authenticator setup.
# Shared with the db-backup cron, which posts a heartbeat after each nightly dump (32+ characters).
BACKUP_HEARTBEAT_TOKEN=local-dev-backup-heartbeat-token-not-secret
# Nightly backup: in_api (pg_dump in the API, needs DATABASE_OWNER_URL + storage) · external · off.
NIGHTLY_BACKUP=in_api
APP_ENCRYPTION_KEY=bG9jYWwtZGV2LWVuY3J5cHRpb24ta2V5LW5vdC1zZWM=
# Closed beta: invite_code (default) · approval · open. Codes: pnpm beta:invite create
SIGNUP_MODE=invite_code
BETA_DEFAULT_CLIENT_LIMIT=50

# Database (PROMPT §4.5). Request traffic uses fitcoach_app (no BYPASSRLS); SystemDb uses fitcoach_system.
# The owner URL is used only by `pnpm db:migrate` / Railway's preDeployCommand, which also creates the
# two roles with the passwords below — keep them in sync with the URLs.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/fitcoach
DATABASE_URL=postgres://fitcoach_app:fitcoach-app-local@localhost:5432/fitcoach
DATABASE_SYSTEM_URL=postgres://fitcoach_system:fitcoach-system-local@localhost:5432/fitcoach
DB_APP_PASSWORD=fitcoach-app-local
DB_SYSTEM_PASSWORD=fitcoach-system-local
DB_POOL_MAX=10

# Email (Mailpit locally — UI at http://localhost:8025). smtp · resend (RESEND_API_KEY) · console (non-production: stores in email_outbox)
EMAIL_PROVIDER=smtp
# smtp (Mailpit locally) · resend · brevo (HTTPS API, for hosts that block SMTP, ADR-0065) · console
# BREVO_API_KEY=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="FitCoach <noreply@fitcoach.local>"

# Storage (RustFS locally, S3-compatible like R2 — console at http://localhost:9001/rustfs/console/)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=localaccesskey
STORAGE_SECRET_ACCESS_KEY=localsecretkey
STORAGE_PRIVATE_BUCKET=fitcoach-local-private
STORAGE_PUBLIC_BUCKET=fitcoach-local-public
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/fitcoach-local-public
# Empty, or pr-<n>/ for PR environments sharing the staging buckets
STORAGE_KEY_PREFIX=
# Soft budget (8 GiB → health "degraded") and hard limit (9 GiB → uploads refused), across both buckets
STORAGE_BUDGET_BYTES=8589934592
STORAGE_HARD_LIMIT_BYTES=9663676416

# Optional: Cloudflare Turnstile on the public enquiry form. Leave unset to skip the challenge.
# TURNSTILE_SECRET_KEY=

# --- web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# Optional, build time: the Turnstile site key matching TURNSTILE_SECRET_KEY.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional, build time: where "Request beta access" emails go. Unset shows "Not configured".
NEXT_PUBLIC_BETA_CONTACT_EMAIL=getfitcoach.app@gmail.com
API_INTERNAL_URL=http://localhost:4000
